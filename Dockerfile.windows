# =========================================================================
#  DevPulse — Windows 11 Native Executable Cross-Compilation Dockerfile
#  Target: x86_64-pc-windows-gnu / NSIS Windows Installer (.exe / .msi)
#  Base: Debian 12 (Bookworm) & Node.js 24 (Latest)
# =========================================================================

# Stage 1: Build Frontend Assets with Node 24 (Latest)
FROM node:24-bookworm-slim AS frontend-builder
WORKDIR /app
COPY package*.json tsconfig.json vite.config.ts index.html ./
COPY src ./src
RUN npm install
RUN npm run build

# Stage 2: Tauri / Rust Windows Cross-Compilation (Debian 12 Bookworm)
FROM rust:bookworm AS tauri-builder

# Install MinGW Windows cross-compiler, NSIS, and essential tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    file \
    mingw-w64 \
    nsis \
    libssl-dev \
    pkg-config \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Rust Windows target
RUN rustup target add x86_64-pc-windows-gnu

# Install Node.js 24 (Latest)
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy built frontend assets from Stage 1
COPY --from=frontend-builder /app/dist ./dist
COPY package*.json ./
COPY src-tauri ./src-tauri

# Install Tauri CLI
RUN npm install -D @tauri-apps/cli

# Configure Cargo for Windows GNU cross-compilation with MinGW
ENV PKG_CONFIG_ALLOW_CROSS=1
ENV CC_x86_64_pc_windows_gnu=x86_64-w64-mingw32-gcc
ENV CXX_x86_64_pc_windows_gnu=x86_64-w64-mingw32-g++
ENV AR_x86_64_pc_windows_gnu=x86_64-w64-mingw32-ar

# Compile Windows Native Executable (.exe)
RUN cargo build --manifest-path src-tauri/Cargo.toml --release --target x86_64-pc-windows-gnu

# Stage 3: Export Artifacts Stage
FROM scratch AS export-stage
COPY --from=tauri-builder /app/src-tauri/target/ /
COPY --from=frontend-builder /app/dist/ /dist/
