{
  "appName": "DevPulse",
  "version": "1.4.2",
  "platform": "windows-x64",
  "buildEngine": "tauri-rust",
  "features": [
    "Windows 11 Mica & Acrylic Translucency",
    "Embedded Offline SQLite 3 WAL Engine",
    "Windows Data Protection API (DPAPI) Keyring",
    "Real-time 60fps Velocity Telemetry",
    "System Tray Background Minimization",
    "Automated GitHub & Jira Bidirectional Sync"
  ],
  "binaryTargets": [
    {
      "type": "portable-exe",
      "relativePath": "src-tauri/target/release/devpulse.exe",
      "architecture": "x64"
    },
    {
      "type": "nsis-installer",
      "relativePath": "src-tauri/target/release/bundle/nsis/DevPulse_1.4.2_x64-setup.exe",
      "architecture": "x64"
    },
    {
      "type": "msi-installer",
      "relativePath": "src-tauri/target/release/bundle/msi/DevPulse_1.4.2_x64_en-US.msi",
      "architecture": "x64"
    }
  ],
  "systemRequirements": {
    "os": "Windows 10 (1809+) or Windows 11 (Build 22000+)",
    "architecture": "x64 / ARM64",
    "minRam": "128 MB (App consumes <15 MB)",
    "runtime": "WebView2 (Pre-installed in Windows 11)"
  }
}
